# The API reads apps/api/.env only; there is no root-level .env.
#
#   npm run setup:credentials   # copies apps/api/.env.example to apps/api/.env with fresh secrets
#
# Then edit apps/api/.env (database, Redis, mail, payments). See README.md → Getting started.
# Google-first paid signup. Secrets belong only in the API environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5200/api/v1/auth/onboarding/google/callback
APP_BASE_URL=http://127.0.0.1:5200
# Required for verified Razorpay webhook activation/refunds.
RAZORPAY_WEBHOOK_SECRET=
